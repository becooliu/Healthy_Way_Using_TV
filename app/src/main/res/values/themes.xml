<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 应用主主题（Android TV 深色主题） -->
    <style name="Theme.HealthyWay" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorPrimary">#FF1976D2</item>
        <item name="android:colorPrimaryDark">#FF1565C0</item>
        <item name="android:colorAccent">#FF42A5F5</item>
        <item name="android:windowBackground">#FF121212</item>
        <item name="android:statusBarColor">#FF121212</item>
        <item name="android:navigationBarColor">#FF121212</item>
    </style>

    <!-- 锁屏主题 - 全屏沉浸式 -->
    <style name="Theme.HealthyWay.Lock" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#FF000000</item>
        <item name="android:statusBarColor">#FF000000</item>
        <item name="android:navigationBarColor">#FF000000</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowShowWallpaper">false</item>
    </style>
</resources>
