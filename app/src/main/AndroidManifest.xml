<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 开机启动权限，用于恢复计时服务 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 前台服务权限（Android 9+） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- 系统悬浮窗权限，用于防止返回桌面绕过锁定 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 禁用触摸屏要求（电视无触摸屏） -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <!-- 声明为Android TV应用 -->
    <uses-feature android:name="android.software.leanback" android:required="true" />

    <application
        android:name=".HealthyWayApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/backup_rules"
        android:icon="@drawable/tv_banner"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:banner="@drawable/tv_banner"
        android:theme="@style/Theme.HealthyWay"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- 主Activity - 设置界面 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:banner="@drawable/tv_banner">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 锁定屏幕Activity - 计时结束时启动 -->
        <activity
            android:name=".ui.lock.LockScreenActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:noHistory="true"
            android:taskAffinity="com.healthyway.tv.lock"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.HealthyWay.Lock" />

        <!-- 计时前台服务 -->
        <service
            android:name=".service.TimerService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- 开机启动接收器 -->
        <receiver
            android:name=".receiver.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
